# This repository publishes the paired Skills, resource server, and release reports
# plus the root documentation and license files.
/*
!/.gitignore
!/README.md
!/交付说明.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/local-web-resources/
!/local-web-resources/**
!/web-resources-server/
!/web-resources-server/**
!/render-web-artifacts/
!/render-web-artifacts/**
!/reports/
!/reports/**

# Local metadata and generated test artifacts
**/.DS_Store
/Dockerfile.opencode
/node_modules/
/package.json
/package-lock.json
**/__pycache__/
**/*.pyc
/*.zip
/*.html
/*.lnk
/opencode-docx-test/

# Local-only tests and fixtures
/local-web-resources/scripts/start_test_server.py
/render-web-artifacts/scripts/smoke-test.mjs
/web-resources-server/test-data/
/web-resources-server/libs/editors/codemirror/addon/mode/multiplex_test.min.js
/web-resources-server/libs/layout/gridstack.js/vitest.config.min.js
/web-resources-server/libs/layout/gridstack.js/vitest.setup.min.js
