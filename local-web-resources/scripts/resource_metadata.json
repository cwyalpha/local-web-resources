  "reveal.js": {
    "version": "5.2.1",
    "category": "布局",
    "desc": "HTML 幻灯片默认框架，支持备注、分步显示与 PDF 打印。",
    "tier": "conditional",
    "global": "Reveal",
    "entrypoints": [
      {
        "kind": "css",
        "path": "libs/layout/reveal.js/reset.min.css",
        "load": "head"
      },
      {
        "kind": "css",
        "path": "libs/layout/reveal.js/reveal.min.css",
        "load": "head"
      },
      {
        "kind": "css",
        "path": "libs/layout/reveal.js/theme/white.min.css",
        "load": "head"
      },
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/reveal.min.js",
        "load": "body-end"
      }
    ],
    "note": "完整用法见 ../references/presentations.md；插件按需加载，公式必须指定本地 KaTeX。",
    "optional_entrypoints": [
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/plugin/markdown/markdown.min.js",
        "load": "after-reveal",
        "when": "Markdown 幻灯片"
      },
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/plugin/highlight/highlight.min.js",
        "load": "after-reveal",
        "when": "代码高亮"
      },
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/plugin/notes/notes.min.js",
        "load": "after-reveal",
        "when": "演讲者备注"
      },
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/plugin/search/search.min.js",
        "load": "after-reveal",
        "when": "搜索"
      },
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/plugin/zoom/zoom.min.js",
        "load": "after-reveal",
        "when": "局部放大"
      },
      {
        "kind": "js",
        "path": "libs/layout/reveal.js/plugin/math/math.min.js",
        "load": "after-reveal",
        "when": "本地 KaTeX 公式"
      }
    ],
    "license": "MIT"
  },
